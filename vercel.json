{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "schedules": {
    "discover-events": {
      "schedule": "0 8 * * 1",
      "timezone": "America/New_York",
      "path": "/api/cron/discover-events",
      "requestMethod": "GET"
    }
  }
}
