# Copy to .env.local for local development: cp .env.example .env.local
# Every variable is documented in docs/IMPLEMENTATION_PLAN.md §9 and validated in src/lib/config.ts.

# --- Supabase (values from `pnpm db:start` / `supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-supabase-status

# --- App ---
APP_URL=http://localhost:3000
APP_TIMEZONE=America/New_York
# UI hint only; the database's app_settings table is authoritative.
ALLOWED_EMAIL_DOMAINS=cornell.edu

# --- LLM (Claude). Defaults to `fake` outside production. ---
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5

# --- Embeddings (Voyage). Defaults to `fake` outside production. ---
EMBEDDINGS_PROVIDER=fake
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
# Changing this requires a database migration.
EMBEDDING_DIM=1024

# --- Email (Resend). Defaults to `fake` outside production. ---
EMAIL_PROVIDER=fake
RESEND_API_KEY=
EMAIL_FROM=

# --- Secrets (required in production; generate with `openssl rand -hex 32`) ---
RESPONSE_TOKEN_SECRET=
CRON_SECRET=

# --- Optional ---
GITHUB_TOKEN=
SHOW_EXISTING_TEAMS=false
