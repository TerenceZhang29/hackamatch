{
  "name": "hackamatch",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:env": "node scripts/local-env.mjs",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/db.ts && prettier --write src/types/db.ts",
    "check:analytics": "node scripts/check-analytics.mts",
    "import:phase0": "tsx --env-file=.env.local --conditions=react-server scripts/import-phase0.ts",
    "seed:dev": "tsx --env-file=.env.local --conditions=react-server scripts/seed-dev.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.52.0",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  }
}
